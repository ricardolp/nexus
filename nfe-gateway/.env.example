# Mesmo Postgres do backend, mas com uma role própria (nfe_gateway_role,
# migration 013_nfe_gateway_scoped_role.sql) — não o usuário `fiscal` que o
# backend Go usa. GRANT só nas tabelas que o nfe-gateway de fato toca (as
# dele + select em organization_companies); sem acesso a
# organization_documents/certificados/etc no nível do próprio Postgres, não
# só por disciplina de código. Senha abaixo é o default de dev local
# definido na migration — trocar com ALTER ROLE antes de qualquer deploy real.
DATABASE_URL=postgresql://nfe_gateway_role:local-dev-nfe-gateway-role-do-not-use-in-production@localhost:5432/fiscal_messaging

# Mesma exchange/broker que o backend passa a publicar quando
# BROKER_BACKEND=rabbitmq (ver internal/platform/broker/rabbitmq.go).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=fiscal.events

# backend inbound_api (POST /v1/inbound/fiscal_documents/nfe) — autenticado
# como um organization_api_client normal (client-credentials JWT por
# organização, ver oauth.py/credentials.py), NÃO com NFE_GATEWAY_SERVICE_TOKEN.
BACKEND_INBOUND_URL=http://localhost:4001

# backend control_plane_api (só POST /v1/oauth/token — troca client_id/
# client_secret por um JWT de curta duração, cacheado por organização).
BACKEND_CONTROL_PLANE_URL=http://localhost:4000

# backend internal_api (cmd/internal_api, porta própria — só material de
# assinatura de certificado). Token estático de serviço-a-serviço, precisa
# bater com NFE_GATEWAY_SERVICE_TOKEN do backend/.env — nada a ver com o
# client_id/client_secret por organização usados para o inbound acima.
BACKEND_INTERNAL_URL=http://localhost:4002
NFE_GATEWAY_SERVICE_TOKEN=local-dev-nfe-gateway-token-do-not-use-in-production

# 32 bytes urlsafe-base64 (gerar com
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# — cifra em repouso o client_secret de cada organização em
# nfe_gateway_organization_credentials. Trocar esta chave invalida todas as
# credenciais já provisionadas (precisam ser reprovisionadas).
NFE_GATEWAY_CREDENTIALS_KEY=

# Object storage compartilhado com o backend (mesmo prefixo/bucket).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../backend/data/storage
OBJECT_STORAGE_PREFIX=fiscal

# Cadência/limites default da consulta de distribuição por NSU (por empresa,
# sobrescrito por organization_company_nfe_distribution_state.poll_interval_seconds).
# 3600 porque decide_next_poll() nunca deixa isso valer menos que 1h de
# qualquer forma — SEFAZ exige esse piso, ver sefaz/distribution_state.py.
DISTRIBUTION_POLL_TICK_SECONDS=30
DISTRIBUTION_DEFAULT_INTERVAL_SECONDS=3600
DISTRIBUTION_MAX_CONCURRENT_SEFAZ_CALLS=8

# Trava de segurança: true (default) força toda chamada à SEFAZ pra
# homologação, não importa o que organization_companies.environment diga —
# só desligar quando estiver deliberadamente pronto pra transmitir de
# verdade. Ver sefaz/environment.py.
SEFAZ_FORCE_HOMOLOGACAO=true

APP_ENV=development
LOG_LEVEL=INFO
