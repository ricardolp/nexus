APP_ENV=development
HTTP_ADDR=:4000
INBOUND_HTTP_ADDR=:4001
INTERNAL_HTTP_ADDR=:4002

DATABASE_URL=postgres://fiscal:fiscal@localhost:5432/fiscal_messaging?sslmode=disable

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ISSUER=fiscal-messaging
JWT_ACCESS_TTL_MINUTES=15
JWT_CLIENT_TTL_MINUTES=60

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

BROKER_BACKEND=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

OBJECT_STORAGE_PREFIX=fiscal

# Azure Key Vault used to store company A1 digital certificates (PFX + private
# key). Authentication uses DefaultAzureCredential (managed identity in
# Azure, `az login` locally). Leave unset to fall back to the local encrypted
# file store (CERT_LOCAL_PATH, requires SECRETS_ENCRYPTION_KEY) — only if
# neither is usable do certificate endpoints respond 503 instead of failing
# startup. See docs/architecture/22_nfe_gateway_service.md.
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net
CERT_LOCAL_PATH=./data/certificates

# 32 bytes, base64-encoded (e.g. `openssl rand -base64 32`). REQUIRED — every
# process that persists fiscal documents needs it: encrypts the local object
# store (control_plane_api, inbound_api, fiscal_worker, inbound_orchestrator_
# worker all fail to start without it, on purpose — fiscal document payloads
# are sensitive and must never land on disk in the clear). Also encrypts
# organization_integrations.client_secret and, when Key Vault is unset, the
# local certificate store above.
SECRETS_ENCRYPTION_KEY=

# Bearer token the internal_api (signing-material endpoint) requires from the
# nfe-gateway service — never exposed to tenants, treat like a DB credential.
NFE_GATEWAY_SERVICE_TOKEN=

# Comma-separated CIDRs internal_api accepts connections from — a code-level
# backstop so a missing/misconfigured firewall rule doesn't silently expose
# it (it hands out certificate private key material). Leave unset to use the
# default (loopback + RFC1918 private ranges, covers typical Docker/K8s
# private networking). This is defense in depth, not a substitute for real
# network isolation or TLS — see InternalAPI's doc comment.
INTERNAL_API_ALLOWED_CIDRS=

# "stub" (default): fiscal_worker authorizes outbound documents itself via
# StubProvider, no external calls — safe default for any environment without
# nfe-gateway actually running to reply. "messaging": hand outbound
# documents off to nfe-gateway over RabbitMQ instead (requires
# BROKER_BACKEND=rabbitmq and a running nfe-gateway outbound_consumer, or
# documents will sit in status=submitted/waiting_external forever).
FISCAL_PROVIDER=stub

# Comma-separated origins allowed to call the APIs directly from a browser
# (the frontend's dev server, typically Vite on 5173/5180).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180

# Required by `make seed` (cmd/seed) — initial passwords fixed for the seeded
# platform staff user and the LS Mtron Brasil tenant admin.
SEED_TI_PASSWORD=
SEED_TENANT_ADMIN_PASSWORD=
