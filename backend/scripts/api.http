@base_control = http://localhost:4000
@base_inbound = http://localhost:4001
@email = admin@example.com
@password = senha-super-segura

### Login
# @name login
POST {{base_control}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Create organization
# @name create_org
POST {{base_control}}/v1/organizations
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "legal_name": "Empresa Demo LTDA",
  "trade_name": "Demo",
  "slug": "empresa-demo"
}

### Select organization context (platform roles only)
# @name login_org
POST {{base_control}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "organization_id": "{{create_org.response.body.id}}"
}

### Invite user (admin, system or support)
# The raw token is published in the identity.user_invited.v1 outbox event.
POST {{base_control}}/v1/users
Authorization: Bearer {{login_org.response.body.access_token}}
Content-Type: application/json

{
  "email": "novo.usuario@example.com",
  "platform_role": "member",
  "organization_id": "{{create_org.response.body.id}}"
}

### Soft-delete platform user (row is kept, hidden from lists)
DELETE {{base_control}}/v1/users/USER_ID
Authorization: Bearer {{login.response.body.access_token}}

### Soft-remove organization member (membership marked removed, user row kept)
DELETE {{base_control}}/v1/organizations/{{create_org.response.body.id}}/members/MEMBER_ID
Authorization: Bearer {{login_org.response.body.access_token}}

### Accept invitation
POST {{base_control}}/v1/auth/invitations/accept
Content-Type: application/json

{
  "token": "TOKEN_RECEBIDO_NO_CONVITE",
  "password": "senha-super-segura"
}

### Create company
# @name create_company
POST {{base_control}}/v1/organizations/{{create_org.response.body.id}}/companies
Authorization: Bearer {{login_org.response.body.access_token}}
Content-Type: application/json

{
  "legal_name": "Filial SP",
  "cnpj": "11.222.333/0001-81",
  "environment": "homologation"
}

### Upload A1 digital certificate for a company
# certificate_base64 is the raw .pfx file, base64-encoded
POST {{base_control}}/v1/organizations/{{create_org.response.body.id}}/companies/{{create_company.response.body.id}}/certificates
Authorization: Bearer {{login_org.response.body.access_token}}
Content-Type: application/json

{
  "certificate_base64": "BASE64_DO_ARQUIVO_PFX",
  "password": "senha-do-certificado"
}

### List company certificates
GET {{base_control}}/v1/organizations/{{create_org.response.body.id}}/companies/{{create_company.response.body.id}}/certificates
Authorization: Bearer {{login_org.response.body.access_token}}

### Get active certificate
GET {{base_control}}/v1/organizations/{{create_org.response.body.id}}/companies/{{create_company.response.body.id}}/certificates/active
Authorization: Bearer {{login_org.response.body.access_token}}

### Create API client
# @name create_client
POST {{base_control}}/v1/organizations/{{create_org.response.body.id}}/api_clients
Authorization: Bearer {{login_org.response.body.access_token}}
Content-Type: application/json

{
  "name": "SAP CPI",
  "source_system": "SAP",
  "org_token": "EXISTING_X_ORG_TOKEN_FROM_QAS"
}

### Attach existing x-Org-Token to an API client (SAP v1 compatibility)
POST {{base_control}}/v1/organizations/{{create_org.response.body.id}}/api_clients/{{create_client.response.body.client.id}}/legacy_org_token
Authorization: Bearer {{login_org.response.body.access_token}}
Content-Type: application/json

{
  "org_token": "EXISTING_X_ORG_TOKEN_FROM_QAS"
}

### Client credentials token
# @name client_token
POST {{base_control}}/v1/oauth/token
Content-Type: application/json

{
  "grant_type": "client_credentials",
  "client_id": "{{create_client.response.body.client.client_id}}",
  "client_secret": "{{create_client.response.body.client_secret}}"
}

### List notifications (most recent first)
GET {{base_control}}/v1/notifications?limit=20
Authorization: Bearer {{login_org.response.body.access_token}}

### List unread notifications only
GET {{base_control}}/v1/notifications?unread=true
Authorization: Bearer {{login_org.response.body.access_token}}

### Unread notification count (for a badge/counter in the UI)
GET {{base_control}}/v1/notifications/unread_count
Authorization: Bearer {{login_org.response.body.access_token}}

### Mark one notification as read
POST {{base_control}}/v1/notifications/NOTIFICATION_ID/read
Authorization: Bearer {{login_org.response.body.access_token}}

### Mark all notifications as read
POST {{base_control}}/v1/notifications/read_all
Authorization: Bearer {{login_org.response.body.access_token}}

### Receive fiscal document (nfe)
# The request body IS the document payload, verbatim from the source system (SAP)
# - there is no envelope. document_type comes from the URL, direction is always
# "outbound" here (inbound documents will arrive through a separate endpoint, not
# yet implemented), organization_company_id/nfe.series/nfe.number/nfe.issuer_cnpj
# are resolved server-side from this same JSON (serie/numero/cnpj_emitente keys).
POST {{base_inbound}}/v1/fiscal_documents/nfe
Authorization: Bearer {{client_token.response.body.access_token}}
Idempotency-Key: 11111111-1111-1111-1111-111111111111
X-Correlation-Id: 22222222-2222-2222-2222-222222222222
Content-Type: application/json

{
  "serie": "1",
  "numero": "000339577",
  "cnpj_emitente": "48344725000808"
}

### Receive fiscal document via frozen SAP v1 path
# Same handler as POST /v1/fiscal_documents/nfe, authenticating with the
# static x-Org-Token used by existing CPI iflows instead of a Bearer JWT.
POST {{base_inbound}}/api/v1/nfe/documents/sap
x-Org-Token: EXISTING_X_ORG_TOKEN_FROM_QAS
Content-Type: application/json

{
  "serie": "1",
  "numero": "000339577",
  "cnpj_emitente": "48344725000808"
}

### Billing statement (JSON) — org member or platform staff
GET {{base_control}}/v1/organizations/{{create_org.response.body.id}}/billing/statement?from=2026-07-01&to=2026-07-31
Authorization: Bearer {{login_org.response.body.access_token}}

### Billing statement (PDF) — platform staff only
GET {{base_control}}/v1/organizations/{{create_org.response.body.id}}/billing/statement.pdf?from=2026-07-01&to=2026-07-31
Authorization: Bearer {{login.response.body.access_token}}

